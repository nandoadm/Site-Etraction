---
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import AnimationBoot from "@components/AnimationBoot.astro";
import ConsentBanner from "@components/ConsentBanner.astro";
import EventTracker from "@components/EventTracker.astro";
import FormEnhancer from "@components/forms/FormEnhancer.astro";
import { site } from "@data/site";
import "@styles/global.css";

type Props = {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
};

const {
  title,
  description,
  canonical,
  image = "/assets/brand/og-home.svg",
  noindex = false,
  structuredData = []
} = Astro.props;

const baseUrl = import.meta.env.PUBLIC_SITE_URL || site.url;
const pageUrl = canonical || new URL(Astro.url.pathname, baseUrl).toString();
const socialImage = new URL(image, baseUrl).toString();
const data = Array.isArray(structuredData) ? structuredData : [structuredData];

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  logo: new URL("/assets/brand/etraction-logo.svg", baseUrl).toString(),
  email: site.email,
  taxID: site.cnpj,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Av. 7 de Setembro, 286, Primeiro Andar, Sala 04",
    addressLocality: "Rio do Sul",
    addressRegion: "SC",
    addressCountry: "BR"
  },
  sameAs: [site.instagram]
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: site.url,
  inLanguage: "pt-BR",
  potentialAction: {
    "@type": "SearchAction",
    target: `${site.url}/blog/?q={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
};

const allStructuredData = [organizationJsonLd, websiteJsonLd, ...data.filter(Boolean)];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111113" />
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="format-detection" content="telephone=no" />
    {allStructuredData.map((entry) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
    <AnimationBoot />
    <EventTracker />
    <FormEnhancer />
  </body>
</html>
