---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="Página não encontrada | Etraction"
  description="A página solicitada não foi encontrada. Acesse serviços, cases, conteúdos ou contato da Etraction."
  noindex
>
  <section class="page-hero" data-animate>
    <h1>Esta página não foi encontrada.</h1>
    <p>
      O conteúdo pode ter mudado de endereço durante a migração. Use os links
      abaixo para continuar navegando ou fale com a Etraction.
    </p>
    <div class="hero-actions">
      <a class="button button-primary" href="/servicos/">Ver serviços</a>
      <a class="button button-secondary" href="/contato/">Ir para contato</a>
    </div>
  </section>
</BaseLayout>
