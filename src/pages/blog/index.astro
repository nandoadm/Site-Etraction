---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { getBlogPostsForBuild } from "@utils/wordpress";
import { breadcrumbSchema } from "@utils/schema";

const posts = await getBlogPostsForBuild();
---

<BaseLayout
  title="Conteúdos sobre crescimento de e-commerce | Etraction"
  description="Artigos, guias, estudos, cases e materiais sobre CRO, mídia paga, CRM, marketplace, plataformas e métricas de e-commerce."
  structuredData={breadcrumbSchema([{ label: "Conteúdos", href: "/blog/" }])}
>
  <Breadcrumbs items={[{ label: "Conteúdos", href: "/blog/" }]} />
  <section class="page-hero" data-animate>
    <h1>Conteúdos para quem precisa decidir melhor no e-commerce.</h1>
    <p>
      A estrutura preserva URLs, autores, datas e autoridade orgânica do blog atual.
      Os artigos reais devem ser migrados do WordPress ou consumidos via CMS headless.
    </p>
  </section>

  <section class="blog-grid" aria-label="Conteúdos editoriais">
    {posts.map((post) => (
      <article class="blog-card" data-animate>
        <h2>{post.title}</h2>
        <p>{post.description}</p>
        <span>{post.category}</span>
        <a href={`/blog/${post.slug}/`}>
          {post.status === "placeholder" ? "Abrir template do conteúdo" : "Ler conteúdo"}
        </a>
      </article>
    ))}
  </section>
</BaseLayout>
