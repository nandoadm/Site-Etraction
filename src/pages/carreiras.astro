---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Icon from "@components/Icon.astro";
import TalentForm from "@components/forms/TalentForm.astro";
import { growth, talentAreas } from "@data/site";
import { breadcrumbSchema } from "@utils/schema";
---

<BaseLayout
  title="Carreiras e banco de talentos | Etraction"
  description="Cadastre seu perfil no banco de talentos da Etraction para oportunidades em performance, CRO, CRM, marketplace, design e e-commerce."
  structuredData={breadcrumbSchema([{ label: "Carreiras", href: "/carreiras/" }])}
>
  <Breadcrumbs items={[{ label: "Carreiras", href: "/carreiras/" }]} />
  <section class="page-hero" data-animate>
    <p class="section-label">
      <Icon name="sprout" size={15} />
      Carreiras
    </p>
    <h1>Trabalhar aqui é entrar para um time que vira família.</h1>
    <p>
      A Etraction é feita de gente que gosta de e-commerce, comemora junto e
      segura a barra junto. Se você quer um lugar onde dá para crescer de
      verdade, deixe seu perfil no nosso banco de talentos.
    </p>
  </section>

  <section class="section" data-animate>
    <ul class="growth-culture-grid growth-culture-grid-light">
      {growth.culture.slice(0, 3).map((pillar) => (
        <li class="growth-pillar growth-pillar-light">
          <span class="growth-pillar-icon" aria-hidden="true">
            <Icon name={pillar.icon} size={20} />
          </span>
          <h2>{pillar.title}</h2>
          <p>{pillar.description}</p>
        </li>
      ))}
    </ul>
    <p class="carreiras-more">
      <a href="/crescimento/">
        Conhecer a cultura da Etraction por completo
        <Icon name="arrow-right" size={16} />
      </a>
    </p>
  </section>

  <section class="contact-layout">
    <div data-animate>
      <TalentForm />
    </div>
    <aside class="contact-panel" data-animate>
      <h2>Áreas que costumam abrir vaga</h2>
      <ul>{talentAreas.map((area) => <li>{area}</li>)}</ul>
      <h3>Privacidade</h3>
      <p>
        Os dados enviados aqui são usados somente para avaliar oportunidades na
        Etraction, com retenção, acesso e descarte definidos pela nossa política
        de privacidade.
      </p>
      <p class="status-note">
        Limite de arquivo previsto: 5 MB. Formatos aceitos: PDF, DOC e DOCX.
      </p>
    </aside>
  </section>
</BaseLayout>
