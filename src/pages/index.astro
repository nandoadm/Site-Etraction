---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/sections/Hero.astro";
import MetricsDashboard from "@components/sections/MetricsDashboard.astro";
import ClientsLogoExperience from "@components/sections/ClientsLogoExperience.astro";
import Problems from "@components/sections/Problems.astro";
import ServicesShowcase from "@components/sections/ServicesShowcase.astro";
import Methodology from "@components/sections/Methodology.astro";
import Partners from "@components/sections/Partners.astro";
import Testimonials from "@components/sections/Testimonials.astro";
import GrowthCulture from "@components/sections/GrowthCulture.astro";
import CommercialForm from "@components/forms/CommercialForm.astro";
---

<BaseLayout
  title="Agência de Performance para E-commerce | Etraction"
  description="Agência de performance para e-commerce: mídia, CRO, CRM, e-mail, social, marketplace e design, com um especialista responsável por cada frente."
>
  <Hero />
  <ClientsLogoExperience />
  <MetricsDashboard />
  <ServicesShowcase />
  <Problems />
  <Methodology />
  <Partners />
  <Testimonials />
  <GrowthCulture variant="compact" />

  <section class="cta-band" data-animate>
    <h2>Traga um desafio real do seu e-commerce para a primeira conversa.</h2>
    <p>
      Você sai da conversa sabendo qual é o próximo movimento da sua loja.
    </p>
    <div class="hero-actions">
      <a class="button button-on-dark" href="/contato/" data-track-event="cta_click" data-track-label="cta band vendas">
        Falar com o time de vendas
      </a>
      <a class="button button-secondary" href="/servicos/" data-track-event="cta_click" data-track-label="cta band serviços">
        Ver todos os serviços
      </a>
    </div>
  </section>

  <section class="section" data-animate>
    <div class="section-header">
      <div>
        <h2>Conte o que precisa crescer, corrigir ou organizar.</h2>
      </div>
      <p>
        Sua mensagem chega direto no time de vendas, que volta com o
        diagnóstico e o próximo passo.
      </p>
    </div>
    <CommercialForm />
  </section>
</BaseLayout>
