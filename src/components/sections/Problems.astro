---
import Icon from "@components/Icon.astro";
import { problems } from "@data/site";
---

<section class="section problems-section" data-animate>
  <div class="section-header">
    <div>
      <p class="section-label">
        <Icon name="circle-alert" size={15} />
        Onde costuma travar
      </p>
      <h2>Quando o e-commerce cresce, o gargalo muda de lugar.</h2>
    </div>
    <p>
      O que travava no tráfego passa a travar na página, depois na base. A gente
      ataca o problema certo, não o mais fácil.
    </p>
  </div>
  <div class="problem-table">
    {problems.map((item) => (
      <article>
        <h3>{item.issue}</h3>
        <p>{item.response}</p>
      </article>
    ))}
  </div>
</section>
