---
import { methodology } from "@data/site";
---

<section class="section methodology-section" data-animate>
  <div class="section-header">
    <h2>Uma jornada contínua de diagnóstico, execução e escala.</h2>
    <p>
      A metodologia evita separar mídia, conversão, relacionamento, operação e
      criatividade quando o cliente precisa decidir com velocidade.
    </p>
  </div>
  <ol class="methodology-timeline">
    {methodology.map((item, index) => (
      <li data-method-step>
        <span>{String(index + 1).padStart(2, "0")}</span>
        <div>
          <h3>{item.step}</h3>
          <p>{item.description}</p>
        </div>
      </li>
    ))}
  </ol>
</section>
