---
import Icon from "@components/Icon.astro";
import { ctas, navigation, operationalLeaders, serviceGroups, services } from "@data/site";

const pathname = Astro.url.pathname;
const serviceByShortName = new Map(services.map((service) => [service.shortName, service]));
---

<header class="site-header">
  <div class="header-shell">
    <a class="brand-link" href="/" aria-label="Etraction, página inicial">
      <img src="/assets/brand/etraction-logo.svg" alt="Etraction" width="329" height="33" />
    </a>

    <nav class="desktop-nav" aria-label="Navegação principal">
      <details class="solutions-menu">
        <summary>
          Soluções
          <Icon name="chevron-down" size={16} class="solutions-caret" />
        </summary>
        <div class="solutions-panel">
          <div class="solutions-groups">
            {serviceGroups.map((group) => (
              <section>
                <h2>{group.objective}</h2>
                <ul>
                  {group.items.map((item) => {
                    const service = serviceByShortName.get(item);
                    if (!service) return null;
                    const leader = service.leaderKey ? operationalLeaders[service.leaderKey] : undefined;
                    return (
                      <li>
                        <a href={`/servicos/${service.slug}/`}>
                          {leader ? (
                            <img
                              class="solutions-avatar"
                              src={leader.avatarSmall}
                              alt=""
                              width="44"
                              height="44"
                              loading="lazy"
                              decoding="async"
                            />
                          ) : (
                            <span class="solutions-avatar solutions-avatar-empty" aria-hidden="true">
                              <Icon name="user-round" size={18} />
                            </span>
                          )}
                          <span class="solutions-text">
                            <strong>{service.shortName}</strong>
                            <span>{service.intent}</span>
                            {leader && <em>com {leader.name}</em>}
                          </span>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </section>
            ))}
          </div>
          <footer class="solutions-footer">
            <a href="/servicos/">
              Ver todas as soluções
              <Icon name="arrow-right" size={16} />
            </a>
            <a
              href={ctas.sales.href}
              target="_blank"
              rel="noreferrer"
              data-track-event="cta_click"
              data-track-label="menu soluções vendas"
            >
              Falar com o time de vendas
              <Icon name="message-circle" size={16} />
            </a>
          </footer>
        </div>
      </details>

      {navigation.slice(1).map((item) => (
        <a href={item.href} aria-current={pathname === item.href ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <a class="header-cta" href="/contato/" data-track-event="cta_click" data-track-label="header vendas">
      Falar com o time de vendas
    </a>

    <details class="mobile-nav">
      <summary aria-label="Abrir menu">
        <span></span>
        <span></span>
        <span></span>
      </summary>
      <div class="mobile-panel">
        <p class="mobile-panel-label">Soluções</p>
        <ul class="mobile-solutions">
          {serviceGroups
            .flatMap((group) => group.items)
            .map((item) => {
              const service = serviceByShortName.get(item);
              if (!service) return null;
              const leader = service.leaderKey ? operationalLeaders[service.leaderKey] : undefined;
              return (
                <li>
                  <a href={`/servicos/${service.slug}/`}>
                    {leader && (
                      <img
                        class="solutions-avatar"
                        src={leader.avatarSmall}
                        alt=""
                        width="36"
                        height="36"
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                    <span>{service.shortName}</span>
                  </a>
                </li>
              );
            })}
        </ul>
        <p class="mobile-panel-label">Navegação</p>
        {navigation.slice(1).map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
        <a class="mobile-panel-cta" href="/contato/">Falar com o time de vendas</a>
      </div>
    </details>
  </div>
</header>
