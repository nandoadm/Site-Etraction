---
import BrandIcon from "@components/BrandIcon.astro";
import { clients, services, site } from "@data/site";

const hasLinkedIn = site.linkedin.startsWith("http");
---

<footer class="site-footer">
  <div class="footer-shell">
    <section class="footer-brand">
      <img src="/assets/brand/etraction-logo-white.svg" alt="Etraction" width="329" height="33" />
      <p>
        Agência de performance para e-commerce com estratégia, mídia, CRO, CRM,
        marketplace, design e acompanhamento próximo.
      </p>
      <div class="footer-social">
        <a href={site.instagram} target="_blank" rel="noreferrer">
          <BrandIcon name="instagram" size={15} />
          Instagram
        </a>
        {hasLinkedIn && (
          <a href={site.linkedin} target="_blank" rel="noreferrer">
            <BrandIcon name="linkedin" size={15} />
            LinkedIn
          </a>
        )}
      </div>
    </section>

    <nav aria-label="Rodapé: serviços">
      <h2>Serviços</h2>
      {services.map((service) => (
        <a href={`/servicos/${service.slug}/`}>{service.shortName}</a>
      ))}
    </nav>

    <nav aria-label="Rodapé: páginas">
      <h2>Institucional</h2>
      <a href="/cases/">Cases</a>
      <a href="/sobre/">Sobre</a>
      <a href="/crescimento/">Crescimento</a>
      <a href="/carreiras/">Carreiras</a>
      <a href="/contato/">Contato</a>
      <a href="/politica-de-privacidade/">Política de privacidade</a>
      <a href="/lgpd/">LGPD</a>
      <button class="footer-cookie-button" type="button" data-open-cookie-preferences>
        Preferências de cookies
      </button>
    </nav>

    <section class="footer-contact">
      <h2>Contato</h2>
      <p>CNPJ: {site.cnpj}</p>
      <p>{site.address}</p>
      <p>Telefone: {site.phone}</p>
      <a href={site.whatsapp} target="_blank" rel="noreferrer">WhatsApp comercial</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </section>
  </div>

  <div class="footer-proof">
    <p>Algumas das marcas que crescem com a Etraction:</p>
    <ul>
      {clients.slice(0, 6).map((client) => <li>{client.name}</li>)}
    </ul>
  </div>

  <div class="footer-bottom">
    <p>© {new Date().getFullYear()} Etraction. Todos os direitos reservados.</p>
  </div>
</footer>
